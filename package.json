{
  "name": "epic-free-games",
  "version": "0.1.2",
  "description": "Automatically claim free games from the Epic Games Store. Works as an OpenClaw Skill or standalone CLI.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "epic-free-games": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "list": "node src/index.js --list",
    "claim": "node src/index.js --claim",
    "claim:visible": "node src/index.js --claim-visible",
    "status": "node src/index.js --status",
    "login": "node src/index.js --login",
    "test": "node --test \"src/__tests__/*.test.js\""
  },
  "keywords": [
    "epic-games",
    "free-games",
    "auto-claim",
    "playwright",
    "openclaw",
    "openclaw-skill"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bigu1/epic-free-games"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "dotenv": "^16.4.0",
    "otplib": "^13.4.1",
    "playwright": "^1.50.0"
  }
}
